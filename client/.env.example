# Frontend environment variables for WareBot AI

# API base URL for the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time simulation streaming
VITE_WS_URL=ws://localhost:8000/api/simulation/stream

# Feature flags: Set to 'true' only to force frontend mock mode without backend
VITE_MOCK_MODE=false
